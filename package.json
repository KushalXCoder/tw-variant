{
  "type": "module",
  "name": "tw-variant",
  "version": "2.4.0",
  "description": "A typescript utility for grouping Tailwind variant prefixes.",
  "keywords": [
    "tailwind",
    "variants",
    "utility"
  ],
  "license": "ISC",
  "author": "Kushal Rathod",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs",
      "import": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/plugins/vite.d.ts",
      "require": "./dist/plugins/vite.cjs",
      "import": "./dist/plugins/vite.js"
    },
    "./next": {
      "types": "./dist/plugins/next.d.ts",
      "require": "./dist/plugins/next.cjs",
      "import": "./dist/plugins/next.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/KushalXCoder/tw-variant"
  },
  "files": [
    "dist",
    "extractor.cjs"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/cli.ts src/extractor.ts src/plugins/next.ts src/plugins/vite.ts --format cjs,esm --dts",
    "test": "tsx test/index.test.ts",
    "extract": "node extractor.cjs"
  },
  "devDependencies": {
    "@types/node": "^25.7.0",
    "next": "^16.2.6",
    "tsup": "^8.5.1",
    "tsx": "^4.7.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.13"
  },
  "dependencies": {
    "chokidar": "^5.0.0",
    "glob": "^10.3.10"
  },
  "bin": {
    "tw-variant-extract": "./dist/cli.cjs"
  }
}
