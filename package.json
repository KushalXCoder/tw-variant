{
  "type": "module",
  "name": "tw-variant",
  "version": "1.2.0",
  "description": "A typescript utility for grouping Tailwind variant prefixes.",
  "keywords": [
    "tailwind",
    "variants",
    "utility"
  ],
  "license": "ISC",
  "author": "Kushal Rathod",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs",
      "import": "./dist/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/KushalXCoder/tw-variant"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "test": "tsx test/index.test.ts"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/types": "^7.29.0",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^25.7.0",
    "tsup": "^8.5.1",
    "tsx": "^4.7.0",
    "typescript": "^6.0.3"
  }
}
